# Snipra defaults for a fresh local install.
# The naive provider works offline without API keys.

LLM_PROVIDER=naive
LLM_MODEL=

# Optional decision recommendations; existing detection/scoring stays authoritative.
DECISION_ENGINE_ENABLED=false
DECISION_ENGINE_PROVIDER=rules
DECISION_ENGINE_MIN_CONFIDENCE=0.65
DECISION_ENGINE_TIMEOUT_MS=2000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

REFRAME_MODE=auto
DEFAULT_FORMATS=9x16

# Sesión existente: auto|none|chrome|brave|edge|firefox|cookies_file.
# Instagram: navegador -> archivo -> público. Otros sitios: público primero.
YT_DLP_COOKIES_FROM_BROWSER=auto
# Ruta absoluta local, archivo .txt legible. AUTO lo usa como fallback.
YT_DLP_COOKIES_PATH=
# Solo habilitar para descargar deliberadamente desde una LAN de confianza.
ALLOW_PRIVATE_DOWNLOADS=false
